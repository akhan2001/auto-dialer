# Copy this file to .env and fill in your Twilio credentials
# See SETUP.md for step-by-step instructions

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Create an API Key in Twilio Console → Account → API Keys
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here

# Create a TwiML App in Twilio Console → Voice → TwiML Apps
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (US number from free trial)
TWILIO_PHONE_NUMBER=+15551234567

PORT=3000
